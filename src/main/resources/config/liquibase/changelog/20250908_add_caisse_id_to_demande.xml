<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20250908-1-add-caisse-id-to-demande" author="ndeeye">
        <!-- Si la colonne existe déjà, ne pas réappliquer -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="demande" columnName="caisse_id"/>
            </not>
        </preConditions>

        <addColumn tableName="demande">
            <column name="caisse_id" type="BIGINT"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="demande" columnName="caisse_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
